<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@android:color/white">
    <ScrollView android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="52" android:fillViewport="true" android:background="#E6EEE5">
        <LinearLayout android:id="@+id/login_intro" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
    <ScrollView android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="48" android:fillViewport="true">
        <LinearLayout android:id="@+id/login_panel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
